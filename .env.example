# Canonical origin used for metadata, sitemap, robots and JSON-LD
NEXT_PUBLIC_SITE_URL=https://ntrx.in

# MySQL. Leave unset for `docker compose up` (uses the bundled db service).
# For `npm run dev` against that container, put this in .env.local:
# DATABASE_URL=mysql://ntrx:ntrx-local@127.0.0.1:3307/ntrx?allowPublicKeyRetrieval=true
DATABASE_URL=

# Bearer token for GET /api/enquiries. Empty = nobody can list enquiries.
ADMIN_TOKEN=
